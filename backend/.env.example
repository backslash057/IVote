# IVote — configuration backend
#
#   cp .env.example .env   puis renseigner les valeurs
#
# Les variables déjà présentes dans l'environnement du système priment sur
# ce fichier. NE JAMAIS COMMITER .env (ignoré par git).

# --- Base de données (obligatoire) -------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ivote
DB_USER=ivote_app
DB_PASS=CHANGE_ME_STRONG_PASSWORD

# --- Sécurité (obligatoire) ---------------------------------------
# Signature JWT. Une valeur absente (ou < 32 caractères) empêche le backend
# de démarrer : génération avec `openssl rand -hex 48`.
IVOTE_JWT_SECRET=CHANGE_ME_96_HEX_CHARS

# --- CORS (obligatoire seulement si le front Flutter web est servi
#     depuis un autre domaine que l'API) --------------------------
# Origines autorisées, séparées par des virgules, sans slash final.
# Sans cette variable, seules les origines de développement suivantes sont
# autorisées : http://localhost:3000 et http://127.0.0.1:3000.
# Exemple en production (décommenter et adapter) :
# IVOTE_ALLOWED_ORIGINS=https://app.ivote.cm,https://ivote.cm

# --- Paiements AangaraaPay (Mobile Money, optionnel) --------------
# AANGARAA_ENABLED=1 active les paiements réels (MTN MoMo / Orange Money).
# Tant qu'il vaut 0 ou est absent, le vote reste simulé (enregistré
# immédiatement) — comportement de développement.
#
# AANGARAA_APP_KEY    : clé fournie par AangaraaPay (compte PIALOA-TECH).
# AANGARAA_API_URL    : base API (défaut = passerelle de production).
# AANGARAA_NOTIFY_URL : URL HTTPS atteignable depuis Internet, appellée par
#                       AangaraaPay pour confirmer les paiements.
# AANGARAA_RETURN_URL : URL de retour client, utilisée par le gateway lorsque
#                       son flux en fournit une.
# AANGARAA_ENABLED=0
# AANGARAA_APP_KEY=
# AANGARAA_API_URL=https://api-production.aangaraa-pay.com/api/v1
# AANGARAA_NOTIFY_URL=https://ivote.arited.org/api/webhooks/aangaraa
# AANGARAA_RETURN_URL=https://ivote.arited.org/payment/return
